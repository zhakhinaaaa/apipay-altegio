# --- Приложение ---
PORT=3000
DB_PATH=./data/app.sqlite
# Публичный HTTPS-адрес приложения
PUBLIC_BASE_URL=

# Включает служебные /dev-адреса (ручной запуск сценария).
# Пусто = выключены. Задавать только если нужны для отладки.
DEV_ENDPOINTS_TOKEN=

# --- Общее для всех салонов ---
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
ALTEGIO_BASE_URL=https://api.alteg.io/api/v1

# Partner token принадлежит приложению целиком, а не отдельному салону.
ALTEGIO_PARTNER_ID=
ALTEGIO_PARTNER_TOKEN=

# Системный пользователь приложения: под ним интеграция ходит в API любого
# филиала, подключившего приложение, и под ним же салон проходит /setup.
ALTEGIO_USER_TOKEN=

# Вебхук ApiPay один на всё приложение, поэтому и секрет подписи один.
# Салон его не вводит — он настраивается на стороне ApiPay один раз.
APIPAY_WEBHOOK_SECRET=

# --- Настройки одного салона ---
# Нужны ТОЛЬКО для первого запуска: при старте из них заводится строка
# в таблице tenants, дальше источник правды — база, а не этот файл.
# Новые салоны добавляются командой:
#   npm run tenant -- add --company <id> --user-token <...> --account <...> \
#                         --apipay-key <...> --apipay-secret <...>
APIPAY_API_KEY=
ALTEGIO_COMPANY_ID=
# Касса Altegio для зачисления предоплаты (2747575 = Расчетный счет)
ALTEGIO_ACCOUNT_ID=
# Статья прихода Altegio (5 = Service payments)
ALTEGIO_EXPENSE_ID=5
